<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Logged out screen. Same palette and wordmark as login, with a single
    action to return to it.
-->
<StackPane styleClass="login-root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="lavs.ui.controller.LoggedOutController"
           prefWidth="900" prefHeight="600"
           stylesheets="@../css/theme.css">

    <VBox alignment="CENTER" spacing="0" maxWidth="-Infinity" maxHeight="-Infinity">

        <Label text="Countrywide Banking Corporation" styleClass="brand-wordmark"
               wrapText="false" textAlignment="CENTER"/>

        <Label text="Mortage Managers Login" styleClass="brand-subtitle"
               textAlignment="CENTER">
            <VBox.margin>
                <Insets top="-4" bottom="26"/>
            </VBox.margin>
        </Label>

        <Label text="LOGGED OUT" styleClass="message-logout"
               textAlignment="CENTER">
            <VBox.margin>
                <Insets bottom="92"/>
            </VBox.margin>
        </Label>

        <Button fx:id="loginAgainButton" text="login again" styleClass="btn-primary, btn-small"
                onAction="#onLoginAgain"/>

    </VBox>

</StackPane>
