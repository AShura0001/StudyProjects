<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Successful lookup, laid out from the Figma frame "successful lookup scene".
    The search bar sits at the top with the register prompt above it, and a
    dark card holds the paged results table. Table rows are built by the
    controller, so Scene Builder shows the header only.
-->
<BorderPane fx:id="root" styleClass="light-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.controller.SearchResultsController"
            prefWidth="900" prefHeight="600"
            stylesheets="@../css/theme.css">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="page-fill">
            <padding>
                <Insets top="10" right="22" bottom="0" left="22"/>
            </padding>

            <Button styleClass="btn-chip" text="Back" onAction="#onBack">
                <graphic>
                    <SVGPath styleClass="chip-icon" content="M20 12 H5 M11 6 L5 12 L11 18"/>
                </graphic>
                <tooltip><Tooltip text="Back (Esc)"/></tooltip>
            </Button>

            <Region HBox.hgrow="ALWAYS"/>

            <Button styleClass="btn-chip, btn-chip-danger" text="Logout"
                    contentDisplay="RIGHT" onAction="#onLogout">
                <graphic>
                    <SVGPath styleClass="chip-icon"
                             content="M9 3 H4 V21 H9 M16 7 L21 12 L16 17 M21 12 H9"/>
                </graphic>
                <tooltip><Tooltip text="Log out (Ctrl+L)"/></tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" styleClass="page-fill">
            <padding>
                <Insets top="6" right="48" bottom="26" left="48"/>
            </padding>

            <HBox alignment="BASELINE_CENTER" spacing="0">
                <Label text="If not available Register by clicking " styleClass="link-text"/>
                <Hyperlink text="here" styleClass="link-inline" onAction="#onRegister"/>
                <Label text="." styleClass="link-text"/>
            </HBox>

            <StackPane maxWidth="-Infinity" maxHeight="-Infinity">
                <VBox.margin>
                    <Insets top="2"/>
                </VBox.margin>
                <TextField fx:id="searchField" styleClass="search-field"
                           promptText="Enter Customer Name or Number"
                           alignment="CENTER" prefWidth="400" maxWidth="400"
                           onAction="#onSearch"/>

                <StackPane StackPane.alignment="CENTER_RIGHT" translateX="-4"
                           maxWidth="-Infinity" maxHeight="-Infinity">
                    <Button fx:id="searchButton" styleClass="btn-search" onAction="#onSearch">
                        <graphic>
                            <SVGPath styleClass="search-icon"
                                     content="M4 10 A6 6 0 1 1 16 10 A6 6 0 1 1 4 10 M14.5 14.5 L20 20"/>
                        </graphic>
                        <tooltip><Tooltip text="Search (Enter)"/></tooltip>
                    </Button>
                    <ProgressIndicator fx:id="progress" visible="false" managed="false"
                                       prefWidth="30" prefHeight="30"/>
                </StackPane>
            </StackPane>

            <Label fx:id="noticeLabel" styleClass="message-muted" wrapText="true"
                   textAlignment="CENTER" visible="false" managed="false"/>

            <VBox styleClass="results-card" VBox.vgrow="ALWAYS" spacing="0" maxWidth="1280">
                <VBox.margin>
                    <Insets top="18"/>
                </VBox.margin>
                <padding>
                    <Insets top="22" right="22" bottom="18" left="22"/>
                </padding>

                <HBox alignment="BOTTOM_LEFT">
                    <VBox.margin>
                        <Insets bottom="14"/>
                    </VBox.margin>
                    <VBox>
                        <Label text="Directory Lookup Results" styleClass="results-title"/>
                        <Label fx:id="countLabel" text="3 people found with similar names"
                               styleClass="results-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="pageLabel" text="Page 1 out of 1" styleClass="results-subtitle"/>
                </HBox>

                <VBox fx:id="tableBox" styleClass="table-box"/>

                <HBox alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets top="12"/>
                    </VBox.margin>
                    <padding>
                        <Insets left="8" right="8"/>
                    </padding>
                    <Button fx:id="previousButton" text="Previous Page" styleClass="btn-pager"
                            onAction="#onPrevious">
                        <graphic>
                            <SVGPath styleClass="pager-icon" content="M20 12 H5 M11 6 L5 12 L11 18"/>
                        </graphic>
                        <tooltip><Tooltip text="Previous page (Page Up)"/></tooltip>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="nextButton" text="Next Page" styleClass="btn-pager, btn-pager-next"
                            contentDisplay="RIGHT" onAction="#onNext">
                        <graphic>
                            <SVGPath styleClass="pager-icon" content="M4 12 H19 M13 6 L19 12 L13 18"/>
                        </graphic>
                        <tooltip><Tooltip text="Next page (Page Down)"/></tooltip>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
