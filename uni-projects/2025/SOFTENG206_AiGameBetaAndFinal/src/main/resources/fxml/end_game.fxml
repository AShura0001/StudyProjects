<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane prefHeight="800.0" prefWidth="1200.0" 
  style="-fx-background-color: linear-gradient(to bottom, #1e3a8a, #3b82f6);"
  xmlns="http://javafx.com/javafx/24.0.1" 
  xmlns:fx="http://javafx.com/fxml/1" 
  fx:controller="nz.ac.auckland.se206.controllers.VerdictController">
  
  <VBox alignment="CENTER" spacing="40" maxWidth="700">
    
    <Label text="Game Complete" 
      style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0.3, 0, 2);" />
    
    <Label text="End of Game" 
      style="-fx-font-size: 28px; -fx-font-weight: 600; -fx-text-fill: #e0e7ff;" />
    
    <VBox alignment="CENTER" spacing="15" 
      style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-background-radius: 16; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0.2, 0, 5);">
      
      <Label text="Thank you for playing!" 
        wrapText="true" maxWidth="600" textAlignment="CENTER"
        style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" />
      
      <Label text="Please choose an option below to continue" 
        wrapText="true" maxWidth="600" textAlignment="CENTER"
        style="-fx-font-size: 18px; -fx-text-fill: #475569; -fx-padding: 10 0 20 0;" />
      
      <HBox alignment="CENTER" spacing="20">
        <Button fx:id="btnReplay" text="Replay" onAction="#onReplay"
          prefWidth="180" prefHeight="55"
          style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.4), 8, 0.3, 0, 3);">
          <HBox.margin>
            <Insets top="10" right="10" bottom="10" left="10" />
          </HBox.margin>
        </Button>
        
        <Button fx:id="btnExit" text="Exit" onAction="#onExit"
          prefWidth="180" prefHeight="55"
          style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(100,116,139,0.4), 8, 0.3, 0, 3);">
          <HBox.margin>
            <Insets top="10" right="10" bottom="10" left="10" />
          </HBox.margin>
        </Button>
      </HBox>
      
    </VBox>
    
  </VBox>
  
</StackPane>
