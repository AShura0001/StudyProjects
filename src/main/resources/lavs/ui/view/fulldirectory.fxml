<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Full directory, laid out from the Figma frame "Full database scene".
    The customer count and page numbers are filled in by the controller; the
    values here are only what Scene Builder previews. Rows are built in code.
-->
<BorderPane fx:id="root" styleClass="light-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.controller.FullDirectoryController"
            prefWidth="900" prefHeight="600"
            stylesheets="@../css/theme.css">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="page-fill">
            <padding>
                <Insets top="10" right="22" bottom="0" left="22"/>
            </padding>

            <Button styleClass="btn-chip" text="Back" onAction="#onBack">
                <graphic>
                    <SVGPath styleClass="chip-icon" content="M20 12 H5 M11 6 L5 12 L11 18"/>
                </graphic>
                <tooltip><Tooltip text="Back (Esc)"/></tooltip>
            </Button>

            <Region HBox.hgrow="ALWAYS"/>

            <Button styleClass="btn-chip, btn-chip-danger" text="Logout"
                    contentDisplay="RIGHT" onAction="#onLogout">
                <graphic>
                    <SVGPath styleClass="chip-icon"
                             content="M9 3 H4 V21 H9 M16 7 L21 12 L16 17 M21 12 H9"/>
                </graphic>
                <tooltip><Tooltip text="Log out (Ctrl+L)"/></tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page-fill" alignment="TOP_CENTER">
            <padding>
                <Insets top="4" right="48" bottom="22" left="48"/>
            </padding>

            <VBox styleClass="results-card" VBox.vgrow="ALWAYS" maxWidth="1280">
                <padding>
                    <Insets top="20" right="22" bottom="14" left="22"/>
                </padding>

                <HBox alignment="BOTTOM_LEFT">
                    <VBox>
                        <Label text="Directory Full Access" styleClass="results-title"/>
                        <Label fx:id="countLabel" text="6767 customers registered"
                               styleClass="results-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="pageLabel" text="Page 1 out of 677" styleClass="results-subtitle"/>
                </HBox>

                <VBox fx:id="tableBox" styleClass="table-box">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets top="8"/>
                    </VBox.margin>
                    <padding>
                        <Insets left="8" right="8"/>
                    </padding>
                    <Button fx:id="previousButton" text="Previous Page" styleClass="btn-pager"
                            onAction="#onPrevious">
                        <graphic>
                            <SVGPath styleClass="pager-icon" content="M20 12 H5 M11 6 L5 12 L11 18"/>
                        </graphic>
                        <tooltip><Tooltip text="Previous page (Page Up)"/></tooltip>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="nextButton" text="Next Page" styleClass="btn-pager, btn-pager-next"
                            contentDisplay="RIGHT" onAction="#onNext">
                        <graphic>
                            <SVGPath styleClass="pager-icon" content="M4 12 H19 M13 6 L19 12 L13 18"/>
                        </graphic>
                        <tooltip><Tooltip text="Next page (Page Down)"/></tooltip>
                    </Button>
                </HBox>
            </VBox>

            <Label fx:id="noticeLabel" styleClass="message-muted" wrapText="true"
                   textAlignment="CENTER" visible="false" managed="false">
                <VBox.margin>
                    <Insets top="6"/>
                </VBox.margin>
            </Label>
        </VBox>
    </center>

</BorderPane>
