<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    A customer's relationships with other customers. No Figma frame; the same dark card
    as the loan notes, with each relationship on its own raised panel built by the controller.
-->
<BorderPane fx:id="root" styleClass="light-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.controller.RelationshipsController"
            prefWidth="900" prefHeight="600"
            stylesheets="@../css/theme.css">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="page-fill">
            <padding>
                <Insets top="10" right="22" bottom="0" left="22"/>
            </padding>

            <Button styleClass="btn-chip" text="Back" onAction="#onBack">
                <graphic>
                    <SVGPath styleClass="chip-icon" content="M20 12 H5 M11 6 L5 12 L11 18"/>
                </graphic>
                <tooltip><Tooltip text="Back (Esc)"/></tooltip>
            </Button>

            <Region HBox.hgrow="ALWAYS"/>

            <Button styleClass="btn-chip, btn-chip-danger" text="Logout"
                    contentDisplay="RIGHT" onAction="#onLogout">
                <graphic>
                    <SVGPath styleClass="chip-icon"
                             content="M9 3 H4 V21 H9 M16 7 L21 12 L16 17 M21 12 H9"/>
                </graphic>
                <tooltip><Tooltip text="Log out (Ctrl+L)"/></tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page-fill" alignment="TOP_CENTER">
            <padding>
                <Insets top="6" right="40" bottom="18" left="40"/>
            </padding>

            <StackPane styleClass="profile-card" maxWidth="680" VBox.vgrow="ALWAYS">

                <VBox fx:id="content" spacing="10">
                    <padding>
                        <Insets top="24" right="34" bottom="20" left="34"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Relationships" styleClass="form-title"/>
                            <Label text="Other customers this customer is related to. Both must be on the mainframe."
                                   styleClass="form-hint" wrapText="true"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="customerIdLabel" text="01-0001-0000020" styleClass="id-tag"
                               prefWidth="150" minWidth="150" maxWidth="150"
                               prefHeight="40" minHeight="40" maxHeight="40"/>
                    </HBox>

                    <ScrollPane styleClass="panel-scroll" fitToWidth="true" hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" focusTraversable="false">
                        <VBox fx:id="relationshipsBox" spacing="8"/>
                    </ScrollPane>

                    <HBox alignment="BOTTOM_RIGHT">
                        <Button text="add relationship" styleClass="btn-action, btn-action-save"
                                onAction="#onAddRelationship">
                            <tooltip><Tooltip text="Add a relationship (Ctrl+N)"/></tooltip>
                        </Button>
                    </HBox>
                </VBox>

                <ProgressIndicator fx:id="progress" visible="false" managed="false"
                                   prefWidth="44" prefHeight="44" maxWidth="44" maxHeight="44"/>
            </StackPane>

            <Label fx:id="noticeLabel" styleClass="message-muted" wrapText="true"
                   textAlignment="CENTER" visible="false" managed="false">
                <VBox.margin>
                    <Insets top="6"/>
                </VBox.margin>
            </Label>
        </VBox>
    </center>

</BorderPane>
