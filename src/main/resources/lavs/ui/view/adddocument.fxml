<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Record a document against a customer or a loan. Choosing a file fills in its name,
    kind and size; only those details are sent, not the file. No Figma frame; the same
    card as the other small edit forms.
-->
<BorderPane fx:id="root" styleClass="light-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.controller.AddDocumentController"
            prefWidth="900" prefHeight="600"
            stylesheets="@../css/theme.css">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="page-fill">
            <padding>
                <Insets top="10" right="22" bottom="0" left="22"/>
            </padding>

            <Button styleClass="btn-chip" text="Back" onAction="#onBack">
                <graphic>
                    <SVGPath styleClass="chip-icon" content="M20 12 H5 M11 6 L5 12 L11 18"/>
                </graphic>
                <tooltip><Tooltip text="Back (Esc)"/></tooltip>
            </Button>

            <Region HBox.hgrow="ALWAYS"/>

            <Button styleClass="btn-chip, btn-chip-danger" text="Logout"
                    contentDisplay="RIGHT" onAction="#onLogout">
                <graphic>
                    <SVGPath styleClass="chip-icon"
                             content="M9 3 H4 V21 H9 M16 7 L21 12 L16 17 M21 12 H9"/>
                </graphic>
                <tooltip><Tooltip text="Log out (Ctrl+L)"/></tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page-fill" alignment="CENTER">
            <padding>
                <Insets top="6" right="40" bottom="18" left="40"/>
            </padding>

            <StackPane styleClass="profile-card" maxWidth="620" maxHeight="340" VBox.vgrow="ALWAYS">

                <VBox fx:id="content" styleClass="editing" spacing="12">
                    <padding>
                        <Insets top="26" right="46" bottom="22" left="46"/>
                    </padding>

                    <Label fx:id="titleLabel" text="Record a document" styleClass="form-title"/>
                    <Label text="Choose the file to fill in its details. Only the details are kept on the mainframe."
                           styleClass="form-hint" wrapText="true"/>

                    <VBox spacing="4">
                        <Label text="Kind of document" styleClass="field-label"/>
                        <ComboBox fx:id="typeField" styleClass="data-field" maxWidth="Infinity" promptText="Choose"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="File" styleClass="field-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="fileNameField" styleClass="data-field" HBox.hgrow="ALWAYS"
                                       promptText="e.g. payslip-october.pdf" maxWidth="Infinity"/>
                            <Button text="choose file" styleClass="btn-action, btn-action-cancel" onAction="#onChooseFile">
                                <tooltip><Tooltip text="Pick the file to record"/></tooltip>
                            </Button>
                        </HBox>
                        <Label fx:id="fileInfoLabel" text="" styleClass="form-hint"/>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <HBox spacing="6" alignment="BOTTOM_RIGHT">
                        <Button text="cancel" styleClass="btn-action, btn-action-cancel" onAction="#onBack">
                            <tooltip><Tooltip text="Cancel (Esc)"/></tooltip>
                        </Button>
                        <Button text="save" styleClass="btn-action, btn-action-save"
                                onAction="#onSubmit">
                            <tooltip><Tooltip text="Save (Ctrl+S)"/></tooltip>
                        </Button>
                    </HBox>
                </VBox>

                <ProgressIndicator fx:id="progress" visible="false" managed="false"
                                   prefWidth="44" prefHeight="44" maxWidth="44" maxHeight="44"/>
            </StackPane>

            <Label fx:id="noticeLabel" styleClass="message-muted" wrapText="true"
                   textAlignment="CENTER" visible="false" managed="false">
                <VBox.margin>
                    <Insets top="6"/>
                </VBox.margin>
            </Label>
        </VBox>
    </center>

</BorderPane>
