<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Customer Search, laid out from the Figma frames "Customer search scene"
    and "failed lookup scene". The pill stays put between states; only the
    text below it and the magnifier change. Back is hidden until it is useful.
-->
<BorderPane fx:id="root" styleClass="light-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.controller.CustomerSearchController"
            prefWidth="900" prefHeight="600"
            stylesheets="@../css/theme.css">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="page-fill">
            <padding>
                <Insets top="10" right="22" bottom="0" left="22"/>
            </padding>

            <Button fx:id="backButton" styleClass="btn-chip" text="Back" onAction="#onBack"
                    visible="false" managed="false">
                <graphic>
                    <SVGPath styleClass="chip-icon" content="M20 12 H5 M11 6 L5 12 L11 18"/>
                </graphic>
                <tooltip><Tooltip text="Back (Esc)"/></tooltip>
            </Button>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="logoutButton" styleClass="btn-chip, btn-chip-danger" text="Logout"
                    contentDisplay="RIGHT" onAction="#onLogout">
                <graphic>
                    <SVGPath styleClass="chip-icon"
                             content="M9 3 H4 V21 H9 M16 7 L21 12 L16 17 M21 12 H9"/>
                </graphic>
                <tooltip><Tooltip text="Log out (Ctrl+L)"/></tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <StackPane styleClass="page-fill">

            <StackPane maxWidth="-Infinity" maxHeight="-Infinity">
                <TextField fx:id="searchField" styleClass="search-field"
                           promptText="Enter Customer Name or Number"
                           alignment="CENTER" prefWidth="400" maxWidth="400"
                           onAction="#onSearch"/>

                <StackPane StackPane.alignment="CENTER_RIGHT" translateX="-4"
                           maxWidth="-Infinity" maxHeight="-Infinity">
                    <Button fx:id="searchButton" styleClass="btn-search" onAction="#onSearch">
                        <graphic>
                            <SVGPath styleClass="search-icon"
                                     content="M4 10 A6 6 0 1 1 16 10 A6 6 0 1 1 4 10 M14.5 14.5 L20 20"/>
                        </graphic>
                        <tooltip><Tooltip text="Search (Enter)"/></tooltip>
                    </Button>
                    <ProgressIndicator fx:id="progress" visible="false" managed="false"
                                       prefWidth="30" prefHeight="30"/>
                </StackPane>
            </StackPane>

            <VBox alignment="TOP_CENTER" spacing="2" translateY="60"
                  prefHeight="64" maxHeight="64" maxWidth="-Infinity">

                <VBox fx:id="idleInfo" alignment="TOP_CENTER">
                    <HBox alignment="BASELINE_CENTER" spacing="0">
                        <Label text="click " styleClass="link-text-dark"/>
                        <Hyperlink text="here" styleClass="link-inline-dark" onAction="#onFullDirectory"/>
                        <Label text=" for full existing records" styleClass="link-text-dark"/>
                    </HBox>
                    <HBox alignment="BASELINE_CENTER" spacing="0">
                        <Label text="click " styleClass="link-text"/>
                        <Hyperlink text="here" styleClass="link-inline" onAction="#onRegister"/>
                        <Label text=" to register a new customer" styleClass="link-text"/>
                    </HBox>
                </VBox>

                <VBox fx:id="notFoundInfo" alignment="TOP_CENTER" spacing="1" visible="false" managed="false">
                    <Label text="this customer does not exist!" styleClass="message-alert"/>
                    <HBox alignment="BASELINE_CENTER" spacing="0">
                        <Label text="Register by clicking " styleClass="link-text"/>
                        <Hyperlink text="here" styleClass="link-inline" onAction="#onRegister"/>
                        <Label text="." styleClass="link-text"/>
                    </HBox>
                </VBox>

                <Label fx:id="noticeLabel" styleClass="message-muted" wrapText="true"
                       textAlignment="CENTER" managed="false"/>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
