<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!--
    Customer Details in view mode, laid out from the Figma frame
    "Customer details (view mode)". Values are filled in by the controller;
    the sample text in the lists is only what Scene Builder previews.
-->
<BorderPane fx:id="root" styleClass="light-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.controller.CustomerDetailsController"
            prefWidth="900" prefHeight="600"
            stylesheets="@../css/theme.css">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="page-fill">
            <padding>
                <Insets top="10" right="22" bottom="0" left="22"/>
            </padding>

            <Button styleClass="btn-chip" text="Back" onAction="#onBack">
                <graphic>
                    <SVGPath styleClass="chip-icon" content="M20 12 H5 M11 6 L5 12 L11 18"/>
                </graphic>
                <tooltip><Tooltip text="Back (Esc)"/></tooltip>
            </Button>

            <Region HBox.hgrow="ALWAYS"/>

            <Button styleClass="btn-chip, btn-chip-danger" text="Logout"
                    contentDisplay="RIGHT" onAction="#onLogout">
                <graphic>
                    <SVGPath styleClass="chip-icon"
                             content="M9 3 H4 V21 H9 M16 7 L21 12 L16 17 M21 12 H9"/>
                </graphic>
                <tooltip><Tooltip text="Log out (Ctrl+L)"/></tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox styleClass="page-fill" alignment="TOP_CENTER">
            <padding>
                <Insets top="6" right="40" bottom="18" left="40"/>
            </padding>

            <StackPane styleClass="profile-card" VBox.vgrow="ALWAYS">

                <HBox fx:id="content" spacing="72">
                    <padding>
                        <Insets top="24" right="30" bottom="20" left="46"/>
                    </padding>

                    <VBox prefWidth="211" minWidth="211" maxWidth="211" spacing="29">

                        <StackPane alignment="TOP_CENTER" prefHeight="201" minHeight="201" maxHeight="201">
                            <StackPane fx:id="photoCard" styleClass="photo-card" prefWidth="211" prefHeight="174"
                                       maxHeight="174" StackPane.alignment="BOTTOM_CENTER">
                                <StackPane fx:id="avatarBox" prefWidth="90" prefHeight="90" maxWidth="90" maxHeight="90"
                                           translateY="14">
                                    <SVGPath styleClass="avatar" scaleX="3.75" scaleY="3.75"
                                             content="M12 3 A4.5 4.5 0 1 1 12 12 A4.5 4.5 0 1 1 12 3 Z M3 21 C3 15.5 7 13.5 12 13.5 C17 13.5 21 15.5 21 21 Z"/>
                                </StackPane>
                                <Button fx:id="photoEditButton" styleClass="btn-edit-chip" text="Edit"
                                        visible="false" managed="false" onAction="#onPhotoEdit"
                                        StackPane.alignment="BOTTOM_RIGHT">
                                    <StackPane.margin>
                                        <Insets right="8" bottom="8"/>
                                    </StackPane.margin>
                                    <graphic>
                                        <SVGPath styleClass="edit-chip-icon"
                                                 content="M4 20 L8 19 L19 8 L16 5 L5 16 Z M14 7 L17 10"/>
                                    </graphic>
                                </Button>
                            </StackPane>
                            <Label fx:id="customerIdLabel" text="CUS-20490" styleClass="id-tag"
                                   prefWidth="111" minWidth="111" maxWidth="111"
                                   prefHeight="49" minHeight="49" maxHeight="49"/>
                        </StackPane>

                        <VBox styleClass="notes-box" prefHeight="126" minHeight="126" maxHeight="126">
                            <Label text="NOTES" styleClass="notes-title" maxWidth="Infinity"/>
                            <TextArea fx:id="notesArea" styleClass="notes-area" editable="false"
                                      wrapText="true" VBox.vgrow="ALWAYS" focusTraversable="false"/>
                        </VBox>
                    </VBox>

                    <StackPane HBox.hgrow="ALWAYS" alignment="TOP_LEFT" maxWidth="456">
                        <VBox spacing="6">
                            <padding>
                                <Insets top="14"/>
                            </padding>

                            <HBox spacing="42">
                                <VBox spacing="4">
                                    <Label text="First Name" styleClass="field-label"/>
                                    <TextField fx:id="firstNameField" styleClass="data-field"
                                               editable="false" focusTraversable="false"
                                               prefWidth="106" maxWidth="106"/>
                                </VBox>
                                <VBox spacing="4">
                                    <Label text="Last Name" styleClass="field-label"/>
                                    <TextField fx:id="lastNameField" styleClass="data-field"
                                               editable="false" focusTraversable="false"
                                               prefWidth="150" maxWidth="150"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="42">
                                <VBox spacing="4">
                                    <Label text="Phone Number" styleClass="field-label"/>
                                    <TextField fx:id="phoneField" styleClass="data-field"
                                               editable="false" focusTraversable="false"
                                               prefWidth="106" maxWidth="106"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Email Address" styleClass="field-label"/>
                                    <TextField fx:id="emailField" styleClass="data-field"
                                               editable="false" focusTraversable="false"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="4">
                                <Label text="Address Line 1" styleClass="field-label"/>
                                <TextField fx:id="addressLine1Field" styleClass="data-field"
                                           editable="false" focusTraversable="false"/>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="Address Line 2" styleClass="field-label"/>
                                <TextField fx:id="addressLine2Field" styleClass="data-field"
                                           editable="false" focusTraversable="false"/>
                            </VBox>

                            <HBox spacing="61" VBox.vgrow="ALWAYS">
                                <VBox.margin>
                                    <Insets top="16"/>
                                </VBox.margin>

                                <VBox styleClass="info-panel" prefWidth="194" minWidth="194"
                                      maxWidth="194" prefHeight="176" minHeight="176" HBox.hgrow="NEVER">
                                    <HBox.margin>
                                        <Insets bottom="22"/>
                                    </HBox.margin>
                                    <Label text="EMPLOYERS" styleClass="panel-title" maxWidth="Infinity"/>
                                    <ScrollPane styleClass="panel-scroll" fitToWidth="true"
                                                hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                                                VBox.vgrow="ALWAYS" focusTraversable="false">
                                        <VBox fx:id="employersBox"/>
                                    </ScrollPane>
                                </VBox>

                                <VBox spacing="4" HBox.hgrow="NEVER">
                                    <VBox styleClass="info-panel" prefWidth="192" minWidth="192"
                                          maxWidth="192" prefHeight="176" minHeight="176" VBox.vgrow="ALWAYS">
                                        <Label text="LOANS" styleClass="panel-title" maxWidth="Infinity"/>
                                        <ScrollPane styleClass="panel-scroll" fitToWidth="true"
                                                    hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                                                    VBox.vgrow="ALWAYS" focusTraversable="false">
                                            <VBox fx:id="loansBox"/>
                                        </ScrollPane>
                                    </VBox>
                                    <Hyperlink text="Add another loan" styleClass="link-add"
                                               onAction="#onAddLoan"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <HBox spacing="22" alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT"
                              maxWidth="-Infinity" maxHeight="-Infinity">
                            <VBox alignment="TOP_CENTER" spacing="3">
                                <Button fx:id="viewModeButton" styleClass="mode-circle, mode-selected" onAction="#onViewMode">
                                    <graphic>
                                        <StackPane>
                                            <SVGPath styleClass="mode-icon"
                                                     content="M2 12 C5 6 9 4 12 4 C15 4 19 6 22 12 C19 18 15 20 12 20 C9 20 5 18 2 12 Z"/>
                                            <SVGPath styleClass="mode-icon-solid"
                                                     content="M9 12 A3 3 0 1 1 15 12 A3 3 0 1 1 9 12 Z"/>
                                        </StackPane>
                                    </graphic>
                                    <tooltip><Tooltip text="View mode"/></tooltip>
                                </Button>
                                <Label text="view mode" styleClass="mode-caption"/>
                            </VBox>
                            <VBox alignment="TOP_CENTER" spacing="3">
                                <Button fx:id="editModeButton" styleClass="mode-circle" onAction="#onEditMode">
                                    <graphic>
                                        <SVGPath styleClass="mode-icon"
                                                 content="M4 20 L8 19 L19 8 L16 5 L5 16 Z M14 7 L17 10"/>
                                    </graphic>
                                    <tooltip><Tooltip text="Edit mode"/></tooltip>
                                </Button>
                                <Label text="edit mode" styleClass="mode-caption"/>
                            </VBox>
                        </HBox>

                        <HBox fx:id="editActions" spacing="6" alignment="BOTTOM_RIGHT"
                              StackPane.alignment="BOTTOM_RIGHT" visible="false" managed="false"
                              maxWidth="-Infinity" maxHeight="-Infinity">
                            <Button fx:id="cancelButton" text="cancel" styleClass="btn-action, btn-action-cancel"
                                    onAction="#onCancel">
                                <tooltip><Tooltip text="Cancel (Esc)"/></tooltip>
                            </Button>
                            <Button fx:id="saveButton" text="save" styleClass="btn-action, btn-action-save"
                                    onAction="#onSave">
                                <tooltip><Tooltip text="Save (Ctrl+S)"/></tooltip>
                            </Button>
                        </HBox>
                    </StackPane>
                </HBox>

                <ProgressIndicator fx:id="progress" visible="false" managed="false"
                                   prefWidth="44" prefHeight="44" maxWidth="44" maxHeight="44"/>
            </StackPane>

            <Label fx:id="noticeLabel" styleClass="message-muted" wrapText="true"
                   textAlignment="CENTER" visible="false" managed="false">
                <VBox.margin>
                    <Insets top="6"/>
                </VBox.margin>
            </Label>
        </VBox>
    </center>

</BorderPane>
