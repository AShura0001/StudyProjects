<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Saved changes (drafts), opened from the sync dots in its own window.
-->
<BorderPane fx:id="root" styleClass="light-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.controller.DraftsController"
            stylesheets="@../css/theme.css">

    <center>
        <StackPane styleClass="page-fill">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <VBox fx:id="content" styleClass="results-card" spacing="8">
                <padding>
                    <Insets top="18" right="20" bottom="16" left="20"/>
                </padding>

                <Label text="Saved changes" styleClass="form-title"/>
                <Label fx:id="summaryLabel" styleClass="form-hint" wrapText="true"/>
                <Label text="Changes are saved on this computer first and sent to the mainframe in the background."
                       styleClass="form-hint" wrapText="true"/>

                <ScrollPane styleClass="panel-scroll" fitToWidth="true" hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" focusTraversable="false">
                    <VBox fx:id="listBox" spacing="8">
                        <padding>
                            <Insets top="4" right="8" bottom="4" left="0"/>
                        </padding>
                    </VBox>
                </ScrollPane>

                <Label fx:id="noticeLabel" styleClass="form-hint" wrapText="true" visible="false" managed="false"/>

                <HBox spacing="6" alignment="CENTER_RIGHT">
                    <Button text="send now" styleClass="btn-action, btn-action-save" onAction="#onSendNow"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="close" styleClass="btn-action, btn-action-cancel" onAction="#onClose"/>
                </HBox>
            </VBox>

            <ProgressIndicator fx:id="progress" visible="false" managed="false"
                               prefWidth="44" prefHeight="44" maxWidth="44" maxHeight="44"/>
        </StackPane>
    </center>

</BorderPane>
