<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="520" prefWidth="720" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.RoomController">

   <top>
      <HBox spacing="12">
         <children>
            <Label text="Control Room" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
         </padding>
      </HBox>
   </top>

   <center>
      <VBox spacing="10">
         <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
         </padding>
         <StackPane fx:id="imageHost" prefHeight="360">
            <children>
               <ImageView fx:id="roomImage" fitHeight="470.0" fitWidth="1.0" />
               <Pane fx:id="hotspotLayer">
                  <Button fx:id="hotspotA" layoutX="14.0" layoutY="41.0" onAction="#onHotspotA" prefHeight="313.0" prefWidth="146.0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-opacity: 0;" />
                  <Button fx:id="hotspotB" layoutX="461.0" layoutY="63.0" onAction="#onHotspotB" prefHeight="269.0" prefWidth="207.0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-opacity: 0;" />
                  <Button fx:id="hotspotC" layoutX="240.0" layoutY="100.0" onAction="#onHotspotC" prefHeight="207.0" prefWidth="176.0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-opacity: 0;" />
                  <Label layoutX="67.0" layoutY="400.0" text="Casey" />
                  <Label layoutX="274.0" layoutY="393.0" text="Cookie Monster" />
                  <Label layoutX="491.0" layoutY="393.0" text="Sentri-Guard" />
               </Pane>
            </children>
         </StackPane>
         <VBox prefHeight="120" spacing="6" />
      </VBox>
   </center>

   <bottom>
      <HBox spacing="8">
         <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
