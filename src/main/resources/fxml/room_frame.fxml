<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<StackPane prefHeight="528.0" prefWidth="744.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.RoomFrameController"> <!-- Layer 1: App frame -->
  <BorderPane fx:id="frameRoot" prefHeight="296.0" prefWidth="744.0">
    <top>
      <HBox spacing="10" style="-fx-padding: 8;">
        <Button fx:id="btnStart" onAction="#onStartGame" prefHeight="31.0" prefWidth="229.0" text="Start" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnEndGame" onAction="#onEndGame" prefHeight="31.0" prefWidth="121.0" text="Deliver Verdict" />
        <Label fx:id="timerLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="02:00" />
      </HBox>
    </top>
    <center> <!-- Swappable content area (room/flashbacks go here) -->
      <StackPane fx:id="contentHost" prefHeight="255.0" prefWidth="567.0" BorderPane.alignment="CENTER" />
    </center>
    <right> <!-- Chat sidebar stays always visible -->
      <fx:include fx:id="chatBox" source="chat.fxml" />
    </right>
      <bottom>
         <Label wrapText="true" contentDisplay="BOTTOM" graphicTextGap="1.0" style="-fx-font-size: 30px; -fx-font-weight: bold;" text="In the Court of Common Clicks, Cookie Monster v2.3 is on trial for auto‑accepting cookies to reduce pop‑ups. Casey’s targeted ads and Sentri‑Guard’s audit reveal a friction‑first design that ignored consent, turning convenience into a question of accountability." BorderPane.alignment="CENTER" />
      </bottom>
  </BorderPane> <!-- Layer 2:
  Overlays on top of everything (hidden by default) -->
  <StackPane fx:id="overlayRoot" managed="false" prefWidth="0.0" style="-fx-background-color: rgba(0,0,0,0.45);" visible="false" />
</StackPane>
