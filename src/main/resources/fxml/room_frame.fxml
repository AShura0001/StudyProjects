<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.RoomFrameController">
   <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#d59f67" height="800.0" stroke="BLACK" strokeType="INSIDE" width="1200.0" />
  <BorderPane fx:id="frameRoot" prefHeight="800.0" prefWidth="1200.0">
    <top>
      <HBox fx:id="headerBar" spacing="10" style="-fx-padding: 12 8 8 8;">
        <Button fx:id="btnStart" onAction="#onStartGame" prefHeight="31.0" prefWidth="229.0" text="Start" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnEndGame" onAction="#onEndGame" prefHeight="31.0" prefWidth="121.0" text="Deliver Verdict" />
        <Label fx:id="timerLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="05:00" textFill="WHITE" />
      </HBox>
    </top>
      <bottom>
         <Label fx:id="introLabel" contentDisplay="BOTTOM" graphicTextGap="1.0" prefHeight="180.0" prefWidth="1146.0" style="-fx-font-size: 30px; -fx-font-weight: bold;" text="In the Court of Common Clicks, Cookie Monster v2.3 is on trial for auto‑accepting cookies to reduce pop‑ups. Casey’s targeted ads and Sentri‑Guard’s audit reveal a friction‑first design that ignored consent, turning convenience into a question of accountability." textFill="WHITE" wrapText="true" BorderPane.alignment="CENTER" />
      </bottom>
      <center> 
      <StackPane fx:id="contentHost" prefHeight="600.0" prefWidth="880.0" BorderPane.alignment="CENTER">
         <VBox alignment="CENTER" spacing="10">
            <padding>
               <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <StackPane fx:id="imageHost" alignment="CENTER" prefHeight="470.0" prefWidth="700.0">
               <children>
                  <ImageView fx:id="roomImage" fitHeight="470.0" fitWidth="700.0" preserveRatio="true" StackPane.alignment="CENTER_LEFT">
                        <image>
                           <Image url="@../images/courtRoom.png" />
                        </image>
                        <StackPane.margin>
                           <Insets left="50.0" />
                        </StackPane.margin>
                     </ImageView>
                  <Pane fx:id="hotspotLayer" prefHeight="470.0" prefWidth="700.0">
                     <Button fx:id="hotspotA" layoutX="105.0" layoutY="72.0" onAction="#onHotspotA" prefHeight="384.0" prefWidth="141.0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-opacity: 0;" />
                     <Button fx:id="hotspotB" layoutX="545.0" layoutY="65.0" onAction="#onHotspotB" prefHeight="387.0" prefWidth="193.0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-opacity: 0;" />
                     <Button fx:id="hotspotC" layoutX="310.0" layoutY="159.0" onAction="#onHotspotC" prefHeight="292.0" prefWidth="201.0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-opacity: 0;" />
                     <Label layoutX="365.0" layoutY="142.0" style="-fx-background-color: #ffffff;" text="Cookie Monster">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font></Label>
                     <Label layoutX="605.0" layoutY="48.0" style="-fx-background-color: #ffffff;" text="Sentri-Guard">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font></Label>
                     <Label layoutX="159.0" layoutY="56.0" style="-fx-background-color: #ffffff;" text="Casey">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                  </Pane>
               </children>
            </StackPane>
            <VBox prefHeight="80" spacing="6" />
         </VBox>
     </StackPane>
      </center>
      <left>
         <VBox fx:id="evidencePanel" alignment="TOP_CENTER" prefWidth="320.0" spacing="12" style="-fx-padding: 14; -fx-background-color: rgba(255,255,255,0.86); -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 18, 0.32, 0, 3);">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Evidence Notes" />
            <TextArea fx:id="evidenceNotesArea" prefHeight="520.0" prefWidth="280.0" promptText="e.g. Sentri-Guard log → supplement ad triggered without consent." style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 13px;" wrapText="false" VBox.vgrow="ALWAYS" />
         </VBox>
      </left>
  </BorderPane>

  <StackPane fx:id="startScreen" style="-fx-background-color: #000000;">
    <ImageView fitHeight="800.0" fitWidth="1200.0" preserveRatio="false">
      <image>
        <Image url="@../images/start_view.png" />
      </image>
    </ImageView>
    <VBox alignment="CENTER" spacing="40">
      <Button fx:id="btnStartGame" onAction="#onStartScreenButton" prefHeight="10.0" prefWidth="151.0" style="-fx-background-color: #ffffff; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(30,144,255,0.6), 15, 0.4, 0, 5);" text="Start Game" textAlignment="CENTER" textFill="#25a4ff" VBox.vgrow="NEVER">
            <VBox.margin>
               <Insets top="200.0" />
            </VBox.margin>
         </Button>
         <StackPane.margin>
            <Insets left="20.0" />
         </StackPane.margin>
    </VBox>
  </StackPane> 
  <StackPane fx:id="overlayRoot" managed="false" prefWidth="0.0" style="-fx-background-color: rgba(0,0,0,0.45);" visible="false" />
</StackPane>
