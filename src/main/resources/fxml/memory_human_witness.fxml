<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/24.0.1"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="nz.ac.auckland.se206.controllers.MemoryController">

  <center>
    <VBox alignment="CENTER" prefWidth="750.0" spacing="10" style="-fx-padding: 5 0 5 0;">
      <!-- Back Button -->
      <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 20 0 20;">
        <Button onAction="#onBackToRoom"
          style="-fx-font-size: 16px; -fx-background-color: #f44336; -fx-text-fill: white; -fx-pref-width: 160; -fx-pref-height: 45; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 5, 0, 2, 2);"
          text="← Back to Room" />
      </HBox>

      <!-- Memory Scene Image -->
      <ImageView fitHeight="350.0" fitWidth="600.0" preserveRatio="true">
        <image>
          <Image url="@/images/memoryscene1-human.png" />
        </image>
      </ImageView>

      <!-- Witness Emotional Assessment Interactive Element -->
      <VBox fx:id="frustrationSection" alignment="CENTER" prefHeight="380.0" prefWidth="750.0"
        spacing="12"
        style="-fx-background-color: #fff5f5; -fx-border-color: #ff6b6b; -fx-border-width: 2; -fx-padding: 15; -fx-border-radius: 10;">

        <VBox alignment="CENTER" spacing="10">
          <Label prefHeight="19.0" prefWidth="748.0"
            style="-fx-font-size: 14px; -fx-text-fill: #666;"
            text="Casey is affected by the privacy violation. How frustrated do you think he is？（frustration level 1 to 10)" />
          <Slider fx:id="frustrationSlider" majorTickUnit="1" max="10" min="1" minorTickCount="0"
            prefHeight="14.0" prefWidth="742.0" showTickLabels="true" showTickMarks="true"
            snapToTicks="true" style="-fx-background-color: transparent;" value="5" />
        </VBox>

        <VBox alignment="CENTER" spacing="15">
          <Button fx:id="btnUnderstandStory" onAction="#onUnderstandStory"
            style="-fx-font-size: 16px; -fx-background-color: #ff9800; -fx-text-fill: white; -fx-pref-width: 150; -fx-pref-height: 45; -fx-border-radius: 8; -fx-background-radius: 8;"
            text="🎯 Guess Level" />
        </VBox>

        <VBox fx:id="frustrationDialogue" alignment="CENTER" prefHeight="180.0" prefWidth="720.0"
          spacing="12"
          style="-fx-padding: 15; -fx-background-color: #f8f8f8; -fx-border-color: #ddd; -fx-border-width: 2; -fx-border-radius: 10;"
          visible="false">
          <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #d32f2f;"
            text="Casey's Personal Account:" />
          <Label fx:id="frustrationDialogueText" minHeight="50" prefWidth="580"
            style="-fx-font-size: 14px; -fx-text-fill: #333; -fx-text-alignment: center; -fx-line-spacing: 3px;"
            text="" wrapText="true" />

          <!-- Context revelation section for verdict influence -->
          <VBox fx:id="contextRevelation" alignment="CENTER" prefHeight="75.0" prefWidth="680.0"
            spacing="8"
            style="-fx-padding: 12; -fx-background-color: #e8f5f8; -fx-border-color: #4caf50; -fx-border-width: 2; -fx-border-radius: 8;"
            visible="false">
            <Label fx:id="contextDetails" minHeight="60" prefWidth="560"
              style="-fx-font-size: 13px; -fx-text-fill: #1b5e20; -fx-text-alignment: center; -fx-line-spacing: 2px;"
              text="" wrapText="true" />
          </VBox>
        </VBox>
      </VBox>
    </VBox>
  </center>

  <!-- Consistent Chat Panel -->
  <right>
    <VBox prefHeight="750.0" prefWidth="400.0" spacing="10"
      style="-fx-padding: 10; -fx-background-color: #f7f7f7;">
      <HBox alignment="CENTER_LEFT" spacing="8">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Chat with" />
        <Label fx:id="lblStatus"
          style="-fx-text-fill: #222; -fx-font-size: 16px; -fx-font-weight: bold;" />
      </HBox>

      <TextArea fx:id="txtaChat" editable="false" prefHeight="630.0" style="-fx-font-size: 14px;"
        wrapText="true" VBox.vgrow="ALWAYS" />

      <HBox spacing="6">
        <TextField fx:id="txtInput" promptText="Type a message..." style="-fx-font-size: 14px;"
          HBox.hgrow="ALWAYS" />
        <Button fx:id="btnSend" onAction="#onSendMessage" style="-fx-font-size: 14px;" text="Send" />
      </HBox>
    </VBox>
  </right>

</BorderPane>