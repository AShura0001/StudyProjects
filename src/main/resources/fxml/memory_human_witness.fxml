<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Slider?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.MemoryController">

    <center>
        <VBox alignment="CENTER" spacing="20">
            <!-- Back button positioned prominently at the top-right -->
            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 20 0 20;">
                <Button text="← Back to Room" onAction="#onBackToRoom" 
                        style="-fx-font-size: 16px; -fx-background-color: #f44336; -fx-text-fill: white; -fx-pref-width: 160; -fx-pref-height: 45; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 5, 0, 2, 2);" />
            </HBox>
            
            <ImageView fitHeight="240" preserveRatio="true">
                <image>
                    <Image url="@/images/memoryscene1-human.png" />
                </image>
            </ImageView>
            
            <!-- Frustration Level Interactive Element -->
            <VBox fx:id="frustrationSection" alignment="CENTER" spacing="15" style="-fx-background-color: #fff5f5; -fx-border-color: #ff6b6b; -fx-border-width: 2; -fx-padding: 20; -fx-border-radius: 10;">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #d32f2f;" text="Witness Frustration Level" />
                <Label wrapText="true" maxWidth="400" style="-fx-font-size: 15px; -fx-text-fill: #555; -fx-text-alignment: center;" 
                       text="The human witness seems upset. Try to guess how frustrated they are feeling on a scale of 1-10." />
                
                <VBox alignment="CENTER" spacing="10">
                    <Slider fx:id="frustrationSlider" min="1" max="10" value="5" prefWidth="350" 
                            style="-fx-background-color: transparent;" showTickLabels="true" showTickMarks="true" 
                            majorTickUnit="1" minorTickCount="0" snapToTicks="true" />
                    <Label fx:id="frustrationValueLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ff6b6b;" text="5" />
                </VBox>
                
                <HBox alignment="CENTER" spacing="20">
                    <Button fx:id="btnHigher" onAction="#onFrustrationHigher" 
                            style="-fx-font-size: 16px; -fx-background-color: #ff5252; -fx-text-fill: white; -fx-pref-width: 100; -fx-pref-height: 40; -fx-border-radius: 5;" 
                            text="Higher" />
                    <Button fx:id="btnLower" onAction="#onFrustrationLower" 
                            style="-fx-font-size: 16px; -fx-background-color: #4caf50; -fx-text-fill: white; -fx-pref-width: 100; -fx-pref-height: 40; -fx-border-radius: 5;" 
                            text="Lower" />
                </HBox>
                
                <VBox fx:id="frustrationDialogue" alignment="CENTER" spacing="10" maxWidth="450" 
                      style="-fx-padding: 15; -fx-background-color: #f0f0f0; -fx-border-color: #ccc; -fx-border-width: 1; -fx-border-radius: 8;" visible="false">
                    <Label fx:id="frustrationSpeaker" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #d32f2f;" text="Human Witness:" />
                    <Label fx:id="frustrationDialogueText" wrapText="true" maxWidth="420" 
                           style="-fx-font-size: 14px; -fx-text-fill: #333; -fx-text-alignment: center; -fx-line-spacing: 2px;" 
                           text="" />
                </VBox>
            </VBox>
        </VBox>
    </center>

    
    <right>
        <VBox prefHeight="480.0" prefWidth="400.0" spacing="12" style="-fx-padding: 18; -fx-background-color: #f7f7f7;">

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 120px;" text="Chat with" />
                <Label fx:id="lblStatus" style="-fx-text-fill: #222; -fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 180px;" />
            </HBox>

            <TextArea fx:id="txtaChat" editable="false" wrapText="true" VBox.vgrow="ALWAYS" prefWidth="380.0" prefHeight="320.0" style="-fx-font-size: 15px;" />

            <HBox spacing="6">
                <TextField fx:id="txtInput" promptText="Type a message..." HBox.hgrow="ALWAYS" prefWidth="280.0" style="-fx-font-size: 15px;" />
                <Button fx:id="btnSend" onAction="#onSendMessage" text="Send" prefWidth="80.0" style="-fx-font-size: 15px;" />
            </HBox>
        </VBox>
    </right>

</BorderPane>