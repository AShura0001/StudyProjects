<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<BorderPane prefHeight="800.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nz.ac.auckland.se206.controllers.MemoryController">

  <center>
    <VBox alignment="CENTER" spacing="20">
      <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 20 0 20;">
        <Button fx:id="btnBackToRoom"
                onAction="#onBackToRoom"
                style="-fx-font-size: 16px; -fx-background-color: #f44336; -fx-text-fill: white; -fx-pref-width: 160; -fx-pref-height: 45; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 5, 0, 2, 2);"
                text="← Back to Room" />
      </HBox>

      <StackPane fx:id="memoryContainer" prefHeight="420" prefWidth="780">
        <ImageView fx:id="memoryBackground" fitHeight="420" preserveRatio="true">
          <image>
            <Image url="@/images/memoryscene2-aiWitness.png" />
          </image>
        </ImageView>

        <!-- Tap-to-start prompt -->
        <VBox fx:id="interactableContainer"
              alignment="CENTER"
              spacing="10"
              style="-fx-background-color: rgba(0,0,0,0.45); -fx-padding: 14; -fx-background-radius: 8;">
          <Label fx:id="interactableLabel"
                 style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"
                 text="Open the Simple Audit Log" />
          <Button fx:id="interactableElement"
                  onAction="#onInteractableClick"
                  style="-fx-font-size: 14px; -fx-background-color: #ffebcd; -fx-text-fill: #222; -fx-pref-width: 220; -fx-background-radius: 8;"
                  text="Show Logs" />
        </VBox>

        <Rectangle fx:id="interactableHighlight"
                   arcHeight="20" arcWidth="20"
                   fill="transparent"
                   height="82.0"
                   stroke="#2ddf93"
                   strokeWidth="3"
                   visible="false"
                   mouseTransparent="true"
                   width="244.0" />

        <!-- SIMPLE AUDIT LOG PANEL -->
        <VBox fx:id="auditPanel"
              maxWidth="760"
              spacing="12"
              style="-fx-background-color: rgba(0,0,0,0.65); -fx-padding: 16; -fx-background-radius: 10;"
              visible="false">
          <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="auditTitle"
                   text="Audit Log"
                   maxWidth="220"
                   textOverrun="ELLIPSIS"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <Label fx:id="auditStatus"
                   style="-fx-text-fill: #2ddf93; -fx-font-size: 12px;"
                   text="Tap Load"
                   maxWidth="240"
                   textOverrun="ELLIPSIS" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="btnLoadSample"
                    text="Load"
                    onAction="#onLoadSample"
                    style="-fx-background-color: #2ddf93; -fx-text-fill: #062b20; -fx-font-weight: bold; -fx-background-radius: 6;" />
            <Button fx:id="btnFilterAllowed"
                    text="Allowed"
                    onAction="#onFilterAllowed"
                    prefHeight="27.0" prefWidth="86.0"
                    style="-fx-background-color: #233; -fx-text-fill: #2ddf93; -fx-background-radius: 6; -fx-border-color: #2ddf93; -fx-border-radius: 6;" />
            <Button fx:id="btnFilterBlocked"
                    text="Blocked"
                    onAction="#onFilterBlocked"
                    prefHeight="27.0" prefWidth="86.0"
                    style="-fx-background-color: #233; -fx-text-fill: #2ddf93; -fx-background-radius: 6; -fx-border-color: #2ddf93; -fx-border-radius: 6;" />
            <Button fx:id="btnResetFilters"
                    text="Reset"
                    onAction="#onResetFilters"
                    prefHeight="27.0" prefWidth="72.0"
                    style="-fx-background-color: #233; -fx-text-fill: #2ddf93; -fx-background-radius: 6; -fx-border-color: #2ddf93; -fx-border-radius: 6;" />
          </HBox>

          <TableView fx:id="auditTable" prefHeight="260" style="-fx-background-color: transparent;">
            <columns>
              <TableColumn fx:id="colTime"    prefWidth="130" text="When" />
              <TableColumn fx:id="colSite"    prefWidth="220" text="Site" />
              <TableColumn fx:id="colAction"  prefWidth="230" text="What" />
              <TableColumn fx:id="colAllowed" prefWidth="140" text="Allowed?" />
            </columns>
          </TableView>

          <HBox alignment="CENTER_RIGHT" spacing="10">
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="btnExplainSelected"
                    text="Explain"
                    onAction="#onExplainSelected"
                    style="-fx-background-color: #003a2b; -fx-text-fill: #2ddf93; -fx-border-color: #2ddf93; -fx-background-radius: 6; -fx-border-radius: 6;" />
            <Button fx:id="btnCloseAudit"
                    text="Close"
                    onAction="#onCloseAudit"
                    style="-fx-background-color: #f0e68c; -fx-text-fill: #222; -fx-background-radius: 6;" />
          </HBox>
        </VBox>
      </StackPane>
    </VBox>
  </center>

  <!-- Matrix-style chat (unchanged) -->
  <right>
    <VBox prefHeight="480.0" prefWidth="400.0" spacing="12" style="-fx-padding: 18; -fx-background-color: black;">
      <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Chat with"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #00ff88; -fx-min-width: 120px;" />
        <Label fx:id="lblStatus"
               style="-fx-text-fill: #00ff88; -fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 180px;" />
      </HBox>

      <TextArea fx:id="txtaChat"
                editable="false"
                wrapText="true"
                VBox.vgrow="ALWAYS"
                prefWidth="380.0"
                prefHeight="320.0"
                style="-fx-control-inner-background: black; -fx-text-fill: #00ff88; -fx-highlight-fill: #00ff88; -fx-highlight-text-fill: black; -fx-font-family: 'Consolas','Menlo','Monaco',monospace; -fx-font-size: 15px;" />

      <HBox spacing="6">
        <TextField fx:id="txtInput"
                   promptText="Type a message..."
                   HBox.hgrow="ALWAYS"
                   prefWidth="280.0"
                   style="-fx-background-color: black; -fx-text-fill: #00ff88; -fx-prompt-text-fill: #2ddf93; -fx-border-color: #00ff88; -fx-font-family: 'Consolas','Menlo','Monaco',monospace; -fx-font-size: 15px;" />
        <Button fx:id="btnSend"
                onAction="#onSendMessage"
                text="Send"
                prefWidth="80.0"
                style="-fx-font-size: 15px; -fx-background-color: #003a2b; -fx-text-fill: #00ff88; -fx-border-color: #00ff88; -fx-background-radius: 6; -fx-border-radius: 6;" />
=======
<BorderPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/24.0.1"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="nz.ac.auckland.se206.controllers.MemoryController">

  <center>
    <VBox alignment="CENTER" spacing="20">
      <!-- Back button positioned prominently at the top-right -->
      <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 20 0 20;">
        <Button text="← Back to Room" onAction="#onBackToRoom"
          style="-fx-font-size: 16px; -fx-background-color: #f44336; -fx-text-fill: white; -fx-pref-width: 160; -fx-pref-height: 45; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 5, 0, 2, 2);" />
      </HBox>

      <ImageView fitHeight="240" preserveRatio="true">
        <image>
          <Image url="@/images/memoryscene2-aiWitness.png" />
        </image>
      </ImageView>

      <VBox fx:id="memoryLog" alignment="CENTER" spacing="8"
        style="-fx-background-color: #fff5f5; -fx-border-color: #dc143c; -fx-border-width: 2; -fx-padding: 16;">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222;"
          text="Memory Processing Log" />
        <Label style="-fx-font-size: 14px; -fx-text-fill: #444;"
          text="AI witness data integrity status:" />
        <Label fx:id="logMessage" style="-fx-font-size: 12px; -fx-text-fill: #c00;"
          text="Memory banks operational!" />
        <VBox spacing="6" alignment="CENTER_LEFT">
          <CheckBox fx:id="chkDataIntegrity" selected="true" disable="true"
            style="-fx-text-fill: #c00; -fx-font-size: 12px;" text="✅ Data integrity verified" />
          <CheckBox fx:id="chkBackupSystems" selected="true" disable="true"
            style="-fx-text-fill: #c00; -fx-font-size: 12px;" text="✅ Backup systems online" />
          <CheckBox fx:id="chkMemoryAccess" selected="true" disable="true"
            style="-fx-text-fill: #c00; -fx-font-size: 12px;" text="✅ Memory access granted" />
        </VBox>
        <HBox alignment="CENTER" spacing="12">
          <Button fx:id="btnAnalyzeMemory" onAction="#onAnalyzeMemory"
            style="-fx-font-size: 14px; -fx-background-color: #ffebcd; -fx-text-fill: #222; -fx-pref-width: 120;"
            text="Analyze Data" />
          <Button fx:id="btnValidateMemory" onAction="#onValidateMemory"
            style="-fx-font-size: 14px; -fx-background-color: #f0e68c; -fx-text-fill: #222; -fx-pref-width: 120;"
            text="Validate" />
        </HBox>
      </VBox>
    </VBox>
  </center>


  <right>
    <VBox prefHeight="480.0" prefWidth="400.0" spacing="12"
      style="-fx-padding: 18; -fx-background-color: #f7f7f7;">

      <HBox spacing="8" alignment="CENTER_LEFT">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 120px;"
          text="Chat with" />
        <Label fx:id="lblStatus"
          style="-fx-text-fill: #222; -fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 180px;" />
      </HBox>

      <TextArea fx:id="txtaChat" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
        prefWidth="380.0" prefHeight="320.0" style="-fx-font-size: 15px;" />

      <HBox spacing="6">
        <TextField fx:id="txtInput" promptText="Type a message..." HBox.hgrow="ALWAYS"
          prefWidth="280.0" style="-fx-font-size: 15px;" />
        <Button fx:id="btnSend" onAction="#onSendMessage" text="Send" prefWidth="80.0"
          style="-fx-font-size: 15px;" />

      </HBox>
    </VBox>
  </right>

</BorderPane>
