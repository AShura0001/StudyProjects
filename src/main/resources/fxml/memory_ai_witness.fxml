<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.MemoryController">

  <center>
    <StackPane>
      <VBox alignment="CENTER" spacing="10" style="-fx-padding: 5 0 5 0;">
        <StackPane fx:id="memoryContainer" prefHeight="470" prefWidth="780">
          <ImageView fx:id="memoryBackground" fitHeight="470.0" fitWidth="780.0" preserveRatio="true">
            <image>
              <Image url="@/images/memoryscene2-aiWitness.png" />
            </image>
          </ImageView>

          <VBox fx:id="interactableContainer" alignment="CENTER" spacing="10" style="-fx-background-color: rgba(0,0,0,0.45); -fx-padding: 14; -fx-background-radius: 8;">
            <Label fx:id="interactableLabel" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Open the Simple Audit Log" />
            <Button fx:id="interactableElement" onAction="#onInteractableClick" style="-fx-font-size: 14px; -fx-background-color: #ffebcd; -fx-text-fill: #222; -fx-pref-width: 220; -fx-background-radius: 8;" text="Show Logs" />
          </VBox>

          <Rectangle fx:id="interactableHighlight" arcHeight="20" arcWidth="20" fill="transparent" height="82.0" mouseTransparent="true" stroke="#2ddf93" strokeWidth="3" visible="false" width="244.0" />

          <VBox fx:id="auditPanel" maxWidth="750" spacing="12" style="-fx-background-color: rgba(0,0,0,0.65); -fx-padding: 16; -fx-background-radius: 10;" visible="false">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label fx:id="auditTitle" maxWidth="220" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Audit Log" textOverrun="ELLIPSIS" />
              <Label fx:id="auditStatus" maxWidth="240" style="-fx-text-fill: #2ddf93; -fx-font-size: 12px;" text="Tap Load" textOverrun="ELLIPSIS" />
              <Pane HBox.hgrow="ALWAYS" />
              <Button fx:id="btnLoadSample" onAction="#onLoadSample" style="-fx-background-color: #2ddf93; -fx-text-fill: #062b20; -fx-font-weight: bold; -fx-background-radius: 6;" text="Load" />
              <Button fx:id="btnFilterAllowed" onAction="#onFilterAllowed" prefHeight="27.0" prefWidth="86.0" style="-fx-background-color: #233; -fx-text-fill: #2ddf93; -fx-background-radius: 6; -fx-border-color: #2ddf93; -fx-border-radius: 6;" text="Allowed" />
              <Button fx:id="btnFilterBlocked" onAction="#onFilterBlocked" prefHeight="27.0" prefWidth="86.0" style="-fx-background-color: #233; -fx-text-fill: #2ddf93; -fx-background-radius: 6; -fx-border-color: #2ddf93; -fx-border-radius: 6;" text="Blocked" />
              <Button fx:id="btnResetFilters" onAction="#onResetFilters" prefHeight="27.0" prefWidth="72.0" style="-fx-background-color: #233; -fx-text-fill: #2ddf93; -fx-background-radius: 6; -fx-border-color: #2ddf93; -fx-border-radius: 6;" text="Reset" />
            </HBox>

            <TableView fx:id="auditTable" prefHeight="260" style="-fx-background-color: transparent;">
              <columns>
                <TableColumn fx:id="colTime" prefWidth="130" text="When" />
                <TableColumn fx:id="colSite" prefWidth="220" text="Site" />
                <TableColumn fx:id="colAction" prefWidth="230" text="What" />
                <TableColumn fx:id="colAllowed" prefWidth="140" text="Allowed?" />
              </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
              <Pane HBox.hgrow="ALWAYS" />
              <Button fx:id="btnExplainSelected" onAction="#onExplainSelected" style="-fx-background-color: #003a2b; -fx-text-fill: #2ddf93; -fx-border-color: #2ddf93; -fx-background-radius: 6; -fx-border-radius: 6;" text="Explain" />
              <Button fx:id="btnCloseAudit" onAction="#onCloseAudit" style="-fx-background-color: #f0e68c; -fx-text-fill: #222; -fx-background-radius: 6;" text="Close" />
            </HBox>
          </VBox>
          
          <!-- Hint box that appears after loading audit log - positioned to overlay image -->
          <VBox fx:id="aiWitnessHintBox" alignment="CENTER" maxWidth="720" spacing="6" style="-fx-padding: 10; -fx-background-color: #e8f5f8; -fx-border-color: #4caf50; -fx-border-width: 2; -fx-border-radius: 8;" visible="false">
            <Label fx:id="aiWitnessHintLabel" prefWidth="680" style="-fx-font-size: 13px; -fx-text-fill: #1b5e20; -fx-text-alignment: center; -fx-line-spacing: 2px;" text="" wrapText="true" />
          </VBox>

          <VBox alignment="CENTER" spacing="10" style="-fx-background-color: rgba(255,255,255,0.92); -fx-padding: 16; -fx-background-radius: 10; -fx-border-color: #ddd; -fx-border-radius: 10;" visible="false">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #222;" text="This memory requires cookie consent to chat." />
            <HBox alignment="CENTER" spacing="10">
              <Button fx:id="btnAccept" onAction="#onAcceptCookies" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-background-radius: 6;" text="Accept &amp; Continue" />
              <Button fx:id="btnExit" onAction="#onDeclineCookies" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 6;" text="Decline &amp; Exit" />
            </HBox>
            <Label fx:id="lblCookiesAccepted" style="-fx-text-fill: #2e7d32; -fx-font-weight: bold;" text="Cookies accepted ✓" visible="false" />
          </VBox>

          <VBox fx:id="frustrationSection" alignment="CENTER" maxWidth="720" spacing="12" style="-fx-background-color: rgba(0,0,0,0.55); -fx-padding: 16; -fx-background-radius: 10;" visible="false">
            <HBox alignment="CENTER_LEFT" spacing="10">
              <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Witness Emotional State" />
              <Pane HBox.hgrow="ALWAYS" />
              <Label style="-fx-text-fill: #ddd;" text="Level:" />
              <Label fx:id="frustrationValueLabel" style="-fx-text-fill: #2ddf93; -fx-font-weight: bold;" text="5" />
            </HBox>

            <Slider fx:id="frustrationSlider" blockIncrement="1" majorTickUnit="1" max="10" min="0" minorTickCount="0" showTickLabels="true" showTickMarks="true" style="-fx-pref-width: 620;" value="5" />

            <HBox alignment="CENTER" spacing="12">
              <Button fx:id="btnLower" onAction="#onFrustrationLower" style="-fx-font-size: 16px; -fx-background-color: #4caf50; -fx-text-fill: white; -fx-pref-width: 100; -fx-pref-height: 40; -fx-border-radius: 5;" text="Lower" />
              <Button fx:id="btnHigher" onAction="#onFrustrationHigher" style="-fx-font-size: 16px; -fx-background-color: #ff5252; -fx-text-fill: white; -fx-pref-width: 100; -fx-pref-height: 40; -fx-border-radius: 5;" text="Higher" />
            </HBox>

            <HBox alignment="CENTER">
              <Button fx:id="btnUnderstandStory" onAction="#onUnderstandStory" style="-fx-font-size: 16px; -fx-background-color: #ff9800; -fx-text-fill: white; -fx-pref-width: 150; -fx-pref-height: 45; -fx-border-radius: 8; -fx-background-radius: 8;" text="🎯 Guess Level" />
            </HBox>

            <VBox fx:id="frustrationDialogue" spacing="6" style="-fx-background-color: rgba(255,255,255,0.9); -fx-padding: 12; -fx-background-radius: 8;" visible="false">
              <Label fx:id="frustrationSpeaker" style="-fx-text-fill: #333; -fx-font-weight: bold;" text="Casey" />
              <Label fx:id="frustrationDialogueText" style="-fx-text-fill: #333;" wrapText="true" />
            </VBox>

            <VBox fx:id="contextRevelation" spacing="6" style="-fx-background-color: rgba(240,230,140,0.95); -fx-padding: 12; -fx-background-radius: 8;" visible="false">
              <Label style="-fx-text-fill: #222; -fx-font-weight: bold;" text="Contextual Evidence" />
              <Label fx:id="contextDetails" style="-fx-text-fill: #222;" wrapText="true" />
            </VBox>
          </VBox>

          <HBox alignment="BOTTOM_CENTER" spacing="10" translateY="170" visible="false">
            <Button fx:id="btnAnalyzeMemory" onAction="#onAnalyzeMemory" style="-fx-font-size: 14px; -fx-background-color: #ffebcd; -fx-text-fill: #222; -fx-pref-width: 120;" text="Analyze Data" />
            <Button fx:id="btnValidateMemory" onAction="#onValidateMemory" style="-fx-font-size: 14px; -fx-background-color: #f0e68c; -fx-text-fill: #222; -fx-pref-width: 120;" text="Validate" />
          </HBox>

          <VBox fx:id="memoryLog" maxWidth="720" spacing="6" style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 10; -fx-background-radius: 8;" visible="false">
            <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="AI Witness Activity" />
            <TextArea editable="false" prefRowCount="3" style="-fx-control-inner-background: black; -fx-text-fill: #2ddf93; -fx-font-family: 'Consolas','Menlo','Monaco',monospace;" wrapText="true" />
          </VBox>

        </StackPane>
      </VBox>

      <Button fx:id="btnBackToRoom" onAction="#onBackToRoom" style="-fx-font-size: 16px; -fx-background-color: #f44336; -fx-text-fill: white; -fx-pref-width: 160; -fx-pref-height: 45; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 5, 0, 2, 2); -fx-translate-x: -10; -fx-translate-y: 10;" text="← Back to Room" StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
               <Insets left="20.0" />
            </StackPane.margin>
         </Button>
    </StackPane>
  </center>

  <right>
    <VBox prefHeight="750.0" prefWidth="400.0" spacing="10" style="-fx-padding: 10; -fx-background-color: black;">
      <HBox alignment="CENTER_LEFT" spacing="8">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00ff88;" text="Chat with" />
        <Label fx:id="lblStatus" style="-fx-text-fill: #00ff88; -fx-font-size: 16px; -fx-font-weight: bold;" />
      </HBox>

      <TextArea fx:id="txtaChat" editable="false" prefHeight="460.0" prefWidth="380.0" style="-fx-control-inner-background: black; -fx-text-fill: #00ff88; -fx-highlight-fill: #00ff88; -fx-highlight-text-fill: black; -fx-font-family: 'Consolas','Menlo','Monaco',monospace; -fx-font-size: 14px;" wrapText="true" VBox.vgrow="NEVER" />

      <HBox spacing="6">
        <TextField fx:id="txtInput" promptText="Type a message..." style="-fx-background-color: black; -fx-text-fill: #00ff88; -fx-prompt-text-fill: #2ddf93; -fx-border-color: #00ff88; -fx-font-family: 'Consolas','Menlo','Monaco',monospace; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnSend" onAction="#onSendMessage" style="-fx-font-size: 14px; -fx-background-color: #003a2b; -fx-text-fill: #00ff88; -fx-border-color: #00ff88; -fx-background-radius: 6; -fx-border-radius: 6;" text="Send" />
      </HBox>
    </VBox>
  </right>

</BorderPane>
