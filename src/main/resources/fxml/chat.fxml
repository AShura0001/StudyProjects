<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="600.0" spacing="12" style="-fx-padding: 18; -fx-background-color: #f7f7f7;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.ChatController">

  <HBox spacing="8" alignment="CENTER_LEFT">
  <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 120px;" text="Chat with" />
  <Label fx:id="lblStatus" style="-fx-text-fill: #222; -fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 180px;" />
  </HBox>


  <TextArea fx:id="txtaChat" editable="false" wrapText="true" prefWidth="580.0" prefHeight="320.0" style="-fx-font-size: 15px;" VBox.vgrow="ALWAYS" />

  <HBox spacing="6">
  <TextField fx:id="txtInput" promptText="Type a message..." prefWidth="440.0" style="-fx-font-size: 15px;" HBox.hgrow="ALWAYS" />
  <Button fx:id="btnSend" onAction="#onSendMessage" text="Send" prefWidth="100.0" style="-fx-font-size: 15px;" />
  </HBox>
</VBox>
