<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.SlideshowController">

  <center>
    <VBox fx:id="slideshowContainer" alignment="CENTER" spacing="20" style="-fx-background-color: black; -fx-padding: 20px;">

      <ImageView fx:id="slideImage" fitHeight="314.0" fitWidth="600" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);" />

      <Label fx:id="slideText" maxWidth="577.0" prefHeight="85.0" prefWidth="577.0" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-line-spacing: 5px;" textAlignment="CENTER" wrapText="true" />

    </VBox>
  </center>

  <bottom>
    <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20px; -fx-background-color: rgba(0,0,0,0.8);">

      <Label fx:id="slideCounter" opacity="0.76" style="-fx-font-size: 14px; -fx-text-fill: #ccc;" text="1 / 3" />

      <HBox alignment="CENTER" spacing="20">
        <Button fx:id="btnPrevious" minWidth="100" onAction="#onPrevious" style="-fx-font-size: 14px; -fx-background-color: #666; -fx-text-fill: white; -fx-padding: 10px 20px; -fx-background-radius: 5px;" text="◀ Previous" />

        <Button fx:id="btnNext" minWidth="120" onAction="#onNext" style="-fx-font-size: 14px; -fx-background-color: #007acc; -fx-text-fill: white; -fx-padding: 10px 20px; -fx-background-radius: 5px;" text="Next ▶" />

        <Button fx:id="btnSkip" minWidth="100" onAction="#onSkip" style="-fx-font-size: 12px; -fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-padding: 8px 16px; -fx-background-radius: 5px;" text="Skip to Memory" />
      </HBox>

      <Label style="-fx-font-size: 11px; -fx-text-fill: #999; -fx-font-style: italic;" text="This flashback will only be shown once. Use the buttons to navigate or skip to the memory." />

    </VBox>
  </bottom>

</BorderPane>
