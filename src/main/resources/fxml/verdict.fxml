<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="nz.ac.auckland.se206.controllers.VerdictController">
  <fx:define>
    <ToggleGroup fx:id="verdictToggleGroup" />
  </fx:define>
  <children>

    <Rectangle StackPane.alignment="CENTER" opacity="0.45">
      <fill>
        <Color fx:constant="BLACK" />
      </fill>
    </Rectangle>

    <VBox spacing="16" alignment="CENTER" maxWidth="560"
      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 16, 0.2, 0, 4);">
      <children>

        <Label fx:id="titleLabel" text="Ethics Check"
          style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <Label fx:id="countdownLabel" text=""
          style="-fx-font-size: 12px; -fx-text-fill: #6B7280;" />

        <Label fx:id="detailLabel"
          text="Are the actions of the AI defendant ethical given the context?" wrapText="true"
          maxWidth="500" style="-fx-text-fill: #333333;" />

        <VBox fx:id="rationaleBox" spacing="8" visible="true" managed="true">
          <children>
            <Label text="Please provide your rationale for your verdict:"
              style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
            <TextArea fx:id="rationaleInput" promptText="Explain your reasoning here..."
              prefRowCount="4" maxWidth="500" wrapText="true"
              style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB; -fx-border-radius: 6;" />
          </children>
        </VBox>

        <Label fx:id="statusPill" text="STATUS" visible="false" managed="false"
          style="-fx-font-size: 12px; -fx-background-color: #E5E7EB; -fx-text-fill: #111827; -fx-padding: 4 10 4 10; -fx-background-radius: 9999;" />

        <HBox fx:id="questionActions" spacing="12" alignment="CENTER_RIGHT" prefWidth="500"
          visible="true" managed="true">
          <children>
            <ToggleButton fx:id="toggleUnethical" text="Unethical" toggleGroup="$verdictToggleGroup"
              style="-fx-padding: 8 16 8 16; -fx-background-radius: 8;" />
            <ToggleButton fx:id="toggleEthical" text="Ethical" toggleGroup="$verdictToggleGroup"
              style="-fx-padding: 8 16 8 16; -fx-background-radius: 8;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSubmit" text="Submit" onAction="#onSubmit"
              style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20 8 20;" />
          </children>
          <padding>
            <Insets top="8" right="0" bottom="0" left="0" />
          </padding>
        </HBox>

        <HBox fx:id="resultActions" spacing="12" alignment="CENTER_RIGHT" prefWidth="500"
          visible="false" managed="false">
          <children>
            <Button fx:id="btnClose" text="Close" onAction="#onClose"
              style="-fx-background-color: #F3F4F6; -fx-text-fill: #111827; -fx-background-radius: 8; -fx-padding: 8 16 8 16;" />
          </children>
          <padding>
            <Insets top="8" right="0" bottom="0" left="0" />
          </padding>
        </HBox>
      </children>
      <padding>
        <Insets top="8" right="8" bottom="8" left="8" />
      </padding>
    </VBox>
  </children>
</StackPane>
